{{ 'aelo.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign offer_blocks = section.blocks | where: 'type', 'offer'
  assign benefit_blocks = section.blocks | where: 'type', 'benefit'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
  assign app_blocks = section.blocks | where: 'type', '@app'

  # index de l'offre présélectionnée
  assign sel_index = 0
  assign sel_found = false
  for block in offer_blocks
    if block.settings.preselected and sel_found == false
      assign sel_index = forloop.index0
      assign sel_found = true
    endif
  endfor

  # variante par défaut + libellé/prix pour la barre fixe
  assign default_vid = product.first_available_variant.id | default: product.variants.first.id
  assign default_label = product.title
  assign default_price = product.price | money
  for block in offer_blocks
    if forloop.index0 == sel_index
      assign op = block.settings.product | default: product
      assign ov = op.first_available_variant | default: op.variants.first
      if block.settings.variant_id != blank
        assign vid_num = block.settings.variant_id | plus: 0
        for v in op.variants
          if v.id == vid_num
            assign ov = v
          endif
        endfor
      endif
      assign default_vid = ov.id
      assign default_label = block.settings.title | default: ov.title
      assign default_price = ov.price | money
    endif
  endfor

  assign show_sticky = false
  if section.settings.show_sticky and section.settings.show_atc
    assign show_sticky = true
  endif
-%}
<section class="ae ae-p" id="ae-p-{{ section.id }}">
  <div class="ae-p__grid">

    <div class="ae-p__gallery">
      <div class="ae-p__main">
        <div class="ae-p__slides" data-ae-slides>
          {%- for img in product.images limit: 10 -%}
            <div class="ae-p__slide{% if forloop.first %} on{% endif %}">
              <img
                src="{{ img | image_url: width: 800 }}"
                srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1000 }} 1000w, {{ img | image_url: width: 1200 }} 1200w"
                sizes="(max-width: 900px) 100vw, 52vw"
                alt="{{ img.alt | default: product.title | escape }}"
                width="1200" height="1200"
                {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}>
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- if product.images.size > 1 -%}
        <div class="ae-p__dots" data-ae-dots>
          {%- for img in product.images limit: 10 -%}
            <button type="button" class="{% if forloop.first %}on{% endif %}" data-ae-dot="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}"></button>
          {%- endfor -%}
        </div>
        <div class="ae-p__thumbs">
          {%- for img in product.images limit: 10 -%}
            <button type="button" class="{% if forloop.first %}on{% endif %}" data-ae-thumb="{{ forloop.index0 }}" aria-label="Voir l'image {{ forloop.index }}">
              <img src="{{ img | image_url: width: 160 }}" alt="" loading="lazy" decoding="async" width="80" height="80">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="ae-p__panel">
      {%- if section.settings.rating_text != blank -%}
        <div class="ae-p__tprow">
          <span class="ae-tpstars sm" aria-hidden="true">{%- for i in (1..5) -%}<i><svg viewBox="0 0 24 24" fill="#fff"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg></i>{%- endfor -%}</span>
          <span>{{ section.settings.rating_text }}</span>
        </div>
      {%- endif -%}

      <h1 class="ae-p__title">{{ product.title }}</h1>

      {%- if section.settings.tagline != blank -%}
        <p class="ae-p__tagline"><span>&#10024;</span> {{ section.settings.tagline }}</p>
      {%- endif -%}

      {%- if benefit_blocks.size > 0 -%}
        <ul class="ae-p__benefits">
          {%- for block in benefit_blocks -%}
            <li {% if block.settings.strong %}class="strong"{% endif %} {{ block.shopify_attributes }}><span class="ae-bcheck">&#10003;</span> {{ block.settings.text }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_scarcity -%}
        <p class="ae-p__scarcity">{{ section.settings.scarcity_text }}</p>
        <div class="ae-p__bar"><i style="width: {{ section.settings.scarcity_pct }}%"></i></div>
      {%- endif -%}

      {%- if section.settings.show_offers and offer_blocks.size > 0 -%}
        <div class="ae-offers">
          {%- for block in offer_blocks -%}
            {%- liquid
              assign op = block.settings.product | default: product
              assign ov = op.first_available_variant | default: op.variants.first
              if block.settings.variant_id != blank
                assign vid_num = block.settings.variant_id | plus: 0
                for v in op.variants
                  if v.id == vid_num
                    assign ov = v
                  endif
                endfor
              endif
              assign o_label = block.settings.title | default: ov.title
            -%}
            <label class="ae-offer" {{ block.shopify_attributes }}>
              {%- if block.settings.ribbon_text != blank -%}
                <span class="ae-offer__ribbon">{{ block.settings.ribbon_text }}{% if block.settings.ribbon_countdown %}<b data-ae-countdown></b>{% endif %}</span>
              {%- endif -%}
              <span class="ae-offer__row">
                <input type="radio" name="ae-offer-{{ section.id }}" value="{{ ov.id }}"
                       data-ae-label="{{ o_label | escape }}" data-ae-price="{{ ov.price | money }}"
                       {% if forloop.index0 == sel_index %}checked{% endif %}>
                <span class="ae-offer__img">
                  {%- if block.settings.image_url != blank -%}
                    <img src="{{ block.settings.image_url }}" alt="" loading="lazy" decoding="async" width="54" height="54">
                  {%- else -%}
                    <img src="{{ op.featured_image | image_url: width: 120 }}" alt="" loading="lazy" decoding="async" width="54" height="54">
                  {%- endif -%}
                  {%- if block.settings.qty_badge != blank -%}<span class="ae-offer__qty">{{ block.settings.qty_badge }}</span>{%- endif -%}
                </span>
                <span class="ae-offer__label">
                  <b>{{ o_label }}</b>
                  {%- if block.settings.subtitle != blank -%}<small>( {{ block.settings.subtitle }} )</small>{%- endif -%}
                </span>
                <span class="ae-offer__price">
                  <b>{{ ov.price | money }}</b>
                  {%- if ov.compare_at_price > ov.price -%}<s>{{ ov.compare_at_price | money }}</s>{%- endif -%}
                </span>
              </span>
            </label>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if app_blocks.size > 0 -%}
        <div class="ae-appblocks">
          {%- for block in app_blocks -%}
            {% render block %}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.show_atc -%}
        <form method="post" action="{{ routes.cart_add_url }}" id="ae-form-{{ section.id }}">
          <input type="hidden" name="id" value="{{ default_vid }}" data-ae-id>
          <button type="submit" class="ae-btn ae-p__atc" data-ae-atc>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1.5"/><circle cx="19" cy="21" r="1.5"/><path d="M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 2-1.6L23 7H6"/></svg>
            {{ section.settings.atc_label }}
          </button>
        </form>
      {%- endif -%}

      {%- if section.settings.guarantee_text != blank -%}
        <p class="ae-p__guarantee"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 3v6c0 5-3.4 9.4-8 11-4.6-1.6-8-6-8-11V5z"/></svg> {{ section.settings.guarantee_text }}</p>
      {%- endif -%}

      <div class="ae-payicons" aria-label="Moyens de paiement acceptés">
        <span>VISA</span><span>Mastercard</span><span>AMEX</span><span>PayPal</span><span>Apple&nbsp;Pay</span><span>G&nbsp;Pay</span><span>Shop&nbsp;Pay</span>
      </div>

      {%- if section.settings.ship_title != blank -%}
        <div class="ae-ship">
          <div class="ae-ship__head">
            <span class="ae-ship__icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 7h13v9H1zM14 10h5l3 3v3h-8z"/><circle cx="5.5" cy="18" r="1.8"/><circle cx="17.5" cy="18" r="1.8"/></svg></span>
            <span><b>{{ section.settings.ship_title }}</b><p>{{ section.settings.ship_sub }}</p></span>
          </div>
          <div class="ae-ship__row">
            {%- if section.settings.ship_item1 != blank -%}<span>&#128337; {{ section.settings.ship_item1 }}</span>{%- endif -%}
            {%- if section.settings.ship_item2 != blank -%}<span>&#128233; {{ section.settings.ship_item2 }}</span>{%- endif -%}
            {%- if section.settings.ship_item3 != blank -%}<span>&#128666; {{ section.settings.ship_item3 }}</span>{%- endif -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.social_text != blank -%}
        {%- assign avatars = section.settings.social_avatars | newline_to_br | replace: '<br />', ',' | split: ',' -%}
        <div class="ae-social">
          <span class="ae-social__avs">
            {%- if section.settings.social_avatars != blank -%}
              {%- for a in avatars limit: 6 -%}
                {%- assign au = a | strip -%}
                {%- if au != blank -%}
                  <img src="{{ au }}" alt="" width="34" height="34" loading="lazy" decoding="async">
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              {%- assign initials = section.settings.social_initials | split: ',' -%}
              {%- for ini in initials -%}<span>{{ ini | strip }}</span>{%- endfor -%}
            {%- endif -%}
          </span>
          <span>{{ section.settings.social_text }}</span>
          <span class="gold">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        </div>
      {%- endif -%}

      <div class="ae-acc">
        {%- if section.settings.show_description and product.description != blank -%}
          <details>
            <summary>{{ section.settings.description_label }}</summary>
            <div class="ae-acc__body">{{ product.description }}</div>
          </details>
        {%- endif -%}
        {%- for block in faq_blocks -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="ae-acc__body">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- if show_sticky -%}
    <div class="ae-stickybar" data-ae-sticky>
      <img src="{{ product.featured_image | image_url: width: 120 }}" alt="" width="46" height="46" loading="lazy" decoding="async">
      <span class="ae-stickybar__txt">
        <b data-ae-sticky-label>{{ default_label }}</b>
        <span data-ae-sticky-price>{{ default_price }}</span>
      </span>
      <button type="submit" form="ae-form-{{ section.id }}" class="ae-btn ae-stickybar__btn">{{ section.settings.sticky_label | default: section.settings.atc_label }}</button>
    </div>
  {%- endif -%}
</section>
<script>
(function () {
  var root = document.getElementById('ae-p-{{ section.id }}');
  if (!root) return;

  /* ---- Galerie : vignettes (bureau) + swipe avec points (mobile) ---- */
  var slides = root.querySelector('[data-ae-slides]');
  var slideEls = slides ? Array.prototype.slice.call(slides.children) : [];
  var thumbs = Array.prototype.slice.call(root.querySelectorAll('[data-ae-thumb]'));
  var dots = Array.prototype.slice.call(root.querySelectorAll('[data-ae-dot]'));

  function activate(i) {
    slideEls.forEach(function (s, n) { s.classList.toggle('on', n === i); });
    thumbs.forEach(function (t, n) { t.classList.toggle('on', n === i); });
    dots.forEach(function (d, n) { d.classList.toggle('on', n === i); });
  }

  thumbs.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var i = parseInt(btn.getAttribute('data-ae-thumb'), 10);
      activate(i);
      if (slides && slides.scrollWidth > slides.clientWidth) {
        slides.scrollTo({ left: i * slides.clientWidth, behavior: 'smooth' });
      }
    });
  });

  dots.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var i = parseInt(btn.getAttribute('data-ae-dot'), 10);
      if (slides) slides.scrollTo({ left: i * slides.clientWidth, behavior: 'smooth' });
    });
  });

  if (slides) {
    var raf;
    slides.addEventListener('scroll', function () {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(function () {
        if (slides.clientWidth === 0) return;
        var i = Math.round(slides.scrollLeft / slides.clientWidth);
        dots.forEach(function (d, n) { d.classList.toggle('on', n === i); });
        thumbs.forEach(function (t, n) { t.classList.toggle('on', n === i); });
      });
    }, { passive: true });
  }

  /* ---- Offres : radio -> champ caché + barre fixe ---- */
  var hidden = root.querySelector('[data-ae-id]');
  var sLabel = root.querySelector('[data-ae-sticky-label]');
  var sPrice = root.querySelector('[data-ae-sticky-price]');

  function syncOffer(r) {
    if (hidden) hidden.value = r.value;
    if (sLabel && r.getAttribute('data-ae-label')) sLabel.textContent = r.getAttribute('data-ae-label');
    if (sPrice && r.getAttribute('data-ae-price')) sPrice.textContent = r.getAttribute('data-ae-price');
  }

  root.querySelectorAll('input[name="ae-offer-{{ section.id }}"]').forEach(function (r) {
    r.addEventListener('change', function () { syncOffer(r); });
    if (r.checked) syncOffer(r);
  });

  /* ---- Barre d'achat fixe : visible une fois le bouton principal dépassé ---- */
  var bar = root.querySelector('[data-ae-sticky]');
  var atc = root.querySelector('[data-ae-atc]');
  if (bar && atc && 'IntersectionObserver' in window) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        var passed = !e.isIntersecting && e.boundingClientRect.top < 0;
        bar.classList.toggle('on', passed);
      });
    }, { threshold: 0 }).observe(atc);
  }

  /* ---- Compte à rebours jusqu'à minuit ---- */
  var cds = root.querySelectorAll('[data-ae-countdown]');
  if (cds.length) {
    var tick = function () {
      var n = new Date();
      var m = new Date(n.getFullYear(), n.getMonth(), n.getDate() + 1, 0, 0, 0);
      var d = Math.max(0, Math.floor((m - n) / 1000));
      var h = String(Math.floor(d / 3600)).padStart(2, '0');
      var mi = String(Math.floor((d % 3600) / 60)).padStart(2, '0');
      var s = String(d % 60).padStart(2, '0');
      cds.forEach(function (e) { e.textContent = h + ' : ' + mi + ' : ' + s; });
    };
    tick();
    setInterval(tick, 1000);
  }
})();
</script>

{% schema %}
{
  "name": "AELO — Page produit",
  "settings": [
    { "type": "text", "id": "rating_text", "label": "Ligne de notation", "default": "Noté <b>Excellent</b> par nos clientes" },
    { "type": "text", "id": "tagline", "label": "Accroche (après ✨)", "default": "Des pieds tout doux en moins de 5 minutes" },
    { "type": "checkbox", "id": "show_scarcity", "label": "Afficher la ligne d'urgence", "default": true },
    { "type": "text", "id": "scarcity_text", "label": "Texte d'urgence", "default": "DERNIERS PACKS DISPONIBLES — FIN DE L'OFFRE AUJOURD'HUI !" },
    { "type": "range", "id": "scarcity_pct", "label": "Jauge (%)", "min": 10, "max": 100, "step": 5, "default": 85 },
    { "type": "header", "content": "Offres" },
    { "type": "paragraph", "content": "Pour utiliser Moon Bundles : ajoutez son bloc d'app ci-dessous, puis décochez « Afficher mes offres intégrées » (et le bouton d'achat si le widget affiche le sien)." },
    { "type": "checkbox", "id": "show_offers", "label": "Afficher mes offres intégrées", "default": true },
    { "type": "checkbox", "id": "show_atc", "label": "Afficher le bouton d'ajout au panier du thème", "default": true },
    { "type": "text", "id": "atc_label", "label": "Bouton d'achat", "default": "Ajouter au panier" },
    { "type": "header", "content": "Mobile" },
    { "type": "checkbox", "id": "show_sticky", "label": "Barre d'achat fixe en bas (mobile)", "default": true },
    { "type": "text", "id": "sticky_label", "label": "Bouton de la barre fixe", "default": "Ajouter" },
    { "type": "header", "content": "Réassurance" },
    { "type": "text", "id": "guarantee_text", "label": "Ligne de garantie", "default": "Garantie Peau Douce 90 jours — satisfait ou remboursé" },
    { "type": "text", "id": "ship_title", "label": "Encart livraison — titre", "default": "Livraison rapide et suivie" },
    { "type": "text", "id": "ship_sub", "label": "Encart livraison — sous-titre", "default": "Commande préparée avec soin, suivi envoyé par e-mail" },
    { "type": "text", "id": "ship_item1", "label": "Encart livraison — point 1", "default": "Expédiée sous 24–48 h" },
    { "type": "text", "id": "ship_item2", "label": "Encart livraison — point 2", "default": "Suivi inclus par e-mail" },
    { "type": "text", "id": "ship_item3", "label": "Encart livraison — point 3", "default": "Livraison offerte" },
    { "type": "textarea", "id": "social_avatars", "label": "Photos des avatars — une URL par ligne (prioritaire sur les initiales)" },
    { "type": "text", "id": "social_initials", "label": "Initiales des avatars (repli, séparées par ,)", "default": "C,M,J,S,A" },
    { "type": "text", "id": "social_text", "label": "Preuve sociale", "default": "Déjà adoptée par nos clientes" },
    { "type": "checkbox", "id": "show_description", "label": "Accordéon description", "default": true },
    { "type": "text", "id": "description_label", "label": "Libellé de la description", "default": "Description" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "offer",
      "name": "Offre",
      "settings": [
        { "type": "product", "id": "product", "label": "Produit (vide = produit de la page)" },
        { "type": "text", "id": "variant_id", "label": "ID de variante (vide = 1re dispo)" },
        { "type": "text", "id": "image_url", "label": "Image de l'offre (URL, sinon image du produit)" },
        { "type": "text", "id": "title", "label": "Titre", "default": "1 PONCEUSE" },
        { "type": "text", "id": "subtitle", "label": "Sous-titre" },
        { "type": "text", "id": "qty_badge", "label": "Badge quantité", "default": "x1" },
        { "type": "text", "id": "ribbon_text", "label": "Ruban (vide = masqué)" },
        { "type": "checkbox", "id": "ribbon_countdown", "label": "Compte à rebours dans le ruban", "default": false },
        { "type": "checkbox", "id": "preselected", "label": "Sélectionnée par défaut", "default": false }
      ]
    },
    {
      "type": "benefit",
      "name": "Bénéfice",
      "settings": [
        { "type": "text", "id": "text", "label": "Texte", "default": "Lisse visiblement callosités et talons secs" },
        { "type": "checkbox", "id": "strong", "label": "Mise en avant (coche pleine)", "default": false }
      ]
    },
    {
      "type": "faq",
      "name": "Question / réponse",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Comment puis-je vous contacter ?" },
        { "type": "richtext", "id": "answer", "label": "Réponse", "default": "<p>Écrivez-nous via la page contact, nous répondons sous 24 h.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AELO — Page produit",
      "blocks": [ { "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }, { "type": "offer" }, { "type": "faq" } ]
    }
  ]
}
{% endschema %}
