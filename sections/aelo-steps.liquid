{{ 'aelo.css' | asset_url | stylesheet_tag }}
<section class="ae ae-steps" style="padding-block: {{ section.settings.pad_top }}px {{ section.settings.pad_bottom }}px;">
  <div class="ae-wrap">
    <h2 class="ae-h">{{ section.settings.heading }} <span class="ae-serif">{{ section.settings.heading_accent }}</span></h2>
    <div class="ae-steps__grid">
      {%- for block in section.blocks -%}
        <div class="ae-step" {{ block.shopify_attributes }}>
          {% render 'aelo-image',
            image: block.settings.image,
            url: block.settings.image_url,
            alt: block.settings.title,
            sizes: '(max-width: 900px) 78vw, 33vw',
            w: 800, h: 840 %}
          <div class="ae-step__head">
            <span class="ae-step__num">{{ forloop.index }}</span>
            <span>{{ block.settings.title }}</span>
          </div>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "AELO — 3 étapes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Une ponceuse qui travaille" },
    { "type": "text", "id": "heading_accent", "label": "Titre (accent serif)", "default": "Pour Vous" },
    { "type": "range", "id": "pad_top", "label": "Espace haut", "min": 0, "max": 120, "step": 4, "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Espace bas", "min": 0, "max": 120, "step": 4, "default": 72 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Étape",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image (prioritaire)" },
        { "type": "text", "id": "image_url", "label": "ou URL d'image (CDN)" },
        { "type": "text", "id": "title", "label": "Titre", "default": "Glisse sur la peau" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Décrivez ce geste en une ou deux phrases." }
      ]
    }
  ],
  "presets": [
    {
      "name": "AELO — 3 étapes",
      "blocks": [ { "type": "step" }, { "type": "step" }, { "type": "step" } ]
    }
  ]
}
{% endschema %}
