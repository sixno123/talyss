{{ 'aelo.css' | asset_url | stylesheet_tag }}
<section class="ae ae-reviews" style="padding-block: {{ section.settings.pad_top }}px {{ section.settings.pad_bottom }}px;">
  <div class="ae-wrap">
    <h2 class="ae-h" style="margin-bottom:40px">{{ section.settings.heading }}</h2>
    <div class="ae-reviews__track" id="ae-rev-{{ section.id }}">
      {%- for block in section.blocks -%}
        <article class="ae-review" {{ block.shopify_attributes }}>
          <span class="ae-tpstars" aria-label="{{ block.settings.stars }} étoiles sur 5">
            {%- for i in (1..block.settings.stars) -%}<i><svg viewBox="0 0 24 24" fill="#fff"><path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2 5.9 20.6l1.4-6.8L2.2 9.1l6.9-.8z"/></svg></i>{%- endfor -%}
          </span>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
          <div class="ae-review__author">
            <span class="ae-review__avatar">
              {%- if block.settings.avatar -%}
                <img src="{{ block.settings.avatar | image_url: width: 96 }}" alt="" width="36" height="36" loading="lazy" decoding="async">
              {%- elsif block.settings.avatar_url != blank -%}
                <img src="{{ block.settings.avatar_url }}" alt="" width="36" height="36" loading="lazy" decoding="async">
              {%- else -%}
                {{- block.settings.author | slice: 0 -}}
              {%- endif -%}
            </span>
            <span>{{ block.settings.author }}</span>
            <span class="ae-review__verified"><svg viewBox="0 0 24 24" fill="#00b67a"><path d="M12 1l3 3h4v4l3 3-3 3v4h-4l-3 3-3-3H5v-4l-3-3 3-3V4h4z"/><path d="M10.6 15.3l-3-3 1.4-1.4 1.6 1.6 4.4-4.4 1.4 1.4z" fill="#fff"/></svg> Cliente vérifiée</span>
          </div>
        </article>
      {%- endfor -%}
    </div>
    <div class="ae-reviews__nav">
      <button type="button" data-ae-prev aria-label="Avis précédents">&#8249;</button>
      <button type="button" data-ae-next aria-label="Avis suivants">&#8250;</button>
    </div>
  </div>
  <div class="ae-reviews__fade"></div>
</section>
<script>
(function () {
  var track = document.getElementById('ae-rev-{{ section.id }}');
  if (!track) return;
  var sec = track.closest('.ae-reviews');
  sec.querySelector('[data-ae-prev]').addEventListener('click', function () { track.scrollBy({ left: -342, behavior: 'smooth' }); });
  sec.querySelector('[data-ae-next]').addEventListener('click', function () { track.scrollBy({ left: 342, behavior: 'smooth' }); });
})();
</script>

{% schema %}
{
  "name": "AELO — Avis clientes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Nos avis récents de la semaine" },
    { "type": "range", "id": "pad_top", "label": "Espace haut", "min": 0, "max": 120, "step": 4, "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Espace bas", "min": 0, "max": 120, "step": 4, "default": 56 }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis",
      "settings": [
        { "type": "range", "id": "stars", "label": "Étoiles", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Titre de l'avis", "default": "Très belle découverte" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Écrivez ici l'avis de votre cliente." },
        { "type": "text", "id": "author", "label": "Prénom", "default": "Camille R." },
        { "type": "image_picker", "id": "avatar", "label": "Photo de la cliente (prioritaire)" },
        { "type": "text", "id": "avatar_url", "label": "ou URL de la photo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "AELO — Avis clientes",
      "blocks": [ { "type": "review" }, { "type": "review" }, { "type": "review" }, { "type": "review" } ]
    }
  ]
}
{% endschema %}
