{%- comment -%}
  Image responsive pour les sections AELO.
  Accepte soit un objet image (sélecteur du thème), soit une URL du CDN Shopify.

  Paramètres :
    image     — objet image (prioritaire)
    url       — URL du CDN en repli
    alt       — texte alternatif
    sizes     — attribut sizes (défaut 100vw)
    ratio     — aspect-ratio CSS appliqué en ligne (ex. '4/3')
    priority  — true pour l'image LCP (sinon lazy)
    w / h     — attributs width/height (défaut 1200x1200)
{%- endcomment -%}
{%- liquid
  assign widths = '400,600,800,1000,1200,1400' | split: ','
  assign src = ''
  assign set = ''

  if image
    assign src = image | image_url: width: 900
  elsif url != blank
    assign base = url | split: '&width=' | first
    assign src = base | append: '&width=900'
  endif
-%}
{%- if src != blank -%}
  {%- capture set -%}
    {%- for w in widths -%}
      {%- assign wn = w | plus: 0 -%}
      {%- if image -%}
        {%- assign u = image | image_url: width: wn -%}
      {%- else -%}
        {%- assign u = base | append: '&width=' | append: wn -%}
      {%- endif -%}
      {{- u }} {{ wn }}w{% unless forloop.last %}, {% endunless %}
    {%- endfor -%}
  {%- endcapture -%}
  <img
    src="{{ src }}"
    srcset="{{ set }}"
    sizes="{{ sizes | default: '100vw' }}"
    alt="{{ alt | escape }}"
    width="{{ w | default: 1200 }}"
    height="{{ h | default: 1200 }}"
    {% if ratio != blank %}style="aspect-ratio:{{ ratio }}"{% endif %}
    {% if priority %}fetchpriority="high"{% else %}loading="lazy" decoding="async"{% endif %}>
{%- endif -%}
